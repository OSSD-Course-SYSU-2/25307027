{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./build",
    "baseUrl": ".",
    "paths": {
      "@ohos/*": ["./oh_modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.ets"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}